        <!-- ==========================================
             VIP SLIDER
        =========================================== -->

        <section
            class="display-location-group display-location-group-slider"
            data-display-group="slider"
        >

            <div class="component-subsection-header">

                <h3>
                    VIP Slider
                </h3>

                <p>
                    نمایش خودرو در اسلایدر ویژه سایت.
                </p>

            </div>

            <div class="display-location-list">

                <article
                    class="display-location-item"
                    data-location="slider-vip"
                    data-placement-type="position"
                >

                    <label class="display-location-select">

                        <input
                            type="checkbox"
                            name="display_locations"
                            value="slider-vip"
                        >

                        <span class="display-location-item-content">

                            <span class="display-location-item-title">
                                VIP Slider
                            </span>

                            <span class="display-location-item-description">
                                نمایش خودرو در اسلایدر ویژه سایت.
                            </span>

                        </span>

                    </label>

                    <!-- PLACEMENT -->

                    <div
                        class="display-location-placement"
                        data-placement-controls
                    >

                        <label class="display-placement-field">

                            <span class="display-placement-label">
                                جایگاه کارت
                            </span>

                            <input
                                type="number"
                                min="1"
                                step="1"
                                inputmode="numeric"
                                data-display-placement="position"
                                aria-label="جایگاه خودرو در VIP Slider"
                                disabled
                            >

                        </label>

                        <span class="display-placement-help">
                            شماره جایگاه خودرو در اسلایدر
                        </span>

                    </div>

                </article>

            </div>

        </section>

