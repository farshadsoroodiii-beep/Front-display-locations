/*==================================================
    CARS DISPLAY LOCATIONS

    Responsibility:
    - Display Locations component UI
    - Location groups
    - Location selection
    - Placement controls
    - Selected / pending visual states
    - Responsive behavior

    Does NOT:
    - API
    - State
    - Save
    - Dirty Detection
    - Backend Persistence
    - Placement Validation

    HTML Contract:

        .cars-display-locations-info
            .display-location-group
                .display-location-list
                    .display-location-item
                        .display-location-select
                        .display-location-placement

    Placement:

        Position:

            .display-location-placement
                .display-placement-field

        Page + Card:

            .display-location-placement
                .display-placement-field-group
                    .display-placement-field
                    .display-placement-field

==================================================*/

/*==================================================
    COMPONENT
==================================================*/

.cars-display-locations-info {

    width: 100%;

}

/*==================================================
    LOCATION GROUP
==================================================*/

.display-location-group {

    display: flex;

    flex-direction: column;

    gap: 20px;

}

.display-location-group + .display-location-group {

    margin-top: 32px;

    padding-top: 32px;

    border-top: 1px dashed #e5e7eb;

}

/*==================================================
    LOCATION LIST
==================================================*/

.display-location-list {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 16px;

}

/*==================================================
    LOCATION ITEM
==================================================*/

.display-location-item {

    display: flex;

    flex-direction: column;

    width: 100%;

    box-sizing: border-box;

    overflow: hidden;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    background: var(--white);

    transition:
        border-color .2s ease,
        background-color .2s ease,
        box-shadow .2s ease;

}

/*==================================================
    LOCATION ITEM HOVER
==================================================*/

.display-location-item:hover {

    border-color: #cbd5e1;

    box-shadow:
        0 4px 14px
        rgba(15, 23, 42, .06);

}

/*==================================================
    LOCATION SELECT
==================================================*/

.display-location-select {

    display: flex;

    align-items: flex-start;

    gap: 12px;

    width: 100%;

    box-sizing: border-box;

    padding: 16px;

    cursor: pointer;

    user-select: none;

}

/*==================================================
    CHECKBOX
==================================================*/

.display-location-select input[type="checkbox"] {

    flex: 0 0 auto;

    width: 18px;

    height: 18px;

    min-height: auto;

    margin: 2px 0 0;

    cursor: pointer;

    accent-color: var(--primary);

}

/*==================================================
    CHECKBOX FOCUS
==================================================*/

.display-location-select input[type="checkbox"]:focus-visible {

    outline: 2px solid var(--primary);

    outline-offset: 2px;

}

/*==================================================
    LOCATION CONTENT
==================================================*/

.display-location-item-content {

    display: flex;

    flex-direction: column;

    gap: 4px;

    min-width: 0;

}

/*==================================================
    LOCATION TITLE
==================================================*/

.display-location-item-title {

    font-size: 14px;

    font-weight: 600;

    line-height: 1.6;

    color: #374151;

    transition:
        color .2s ease;

}

/*==================================================
    LOCATION DESCRIPTION
==================================================*/

.display-location-item-description {

    font-size: 12px;

    line-height: 1.7;

    color: #6b7280;

}

/*==================================================
    SELECTED LOCATION
==================================================*/

.display-location-item.is-selected {

    border-color: var(--primary);

    background: #f8fafc;

    box-shadow:
        0 4px 14px
        rgba(5, 42, 68, .08);

}

/*==================================================
    SELECTED LOCATION TITLE
==================================================*/

.display-location-item.is-selected
.display-location-item-title {

    color: var(--primary);

}

/*==================================================
    PLACEMENT AREA
==================================================*/

.display-location-placement {

    display: flex;

    flex-direction: column;

    gap: 12px;

    width: 100%;

    box-sizing: border-box;

    padding: 16px;

    border-top: 1px solid #eef0f3;

    background: #fafbfc;

    opacity: .72;

    transition:
        opacity .2s ease,
        background-color .2s ease;

}

/*==================================================
    ENABLED PLACEMENT
==================================================*/

.display-location-item.is-selected
.display-location-placement {

    opacity: 1;

    background: #f8fafc;

}

/*==================================================
    PLACEMENT FIELD GROUP
==================================================*/

.display-placement-field-group {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;

    width: 100%;

}

/*==================================================
    PLACEMENT FIELD
==================================================*/

.display-placement-field {

    display: flex;

    flex-direction: column;

    gap: 6px;

    min-width: 0;

}

/*==================================================
    PLACEMENT LABEL
==================================================*/

.display-placement-label {

    font-size: 12px;

    font-weight: 600;

    line-height: 1.5;

    color: #4b5563;

}

/*==================================================
    PLACEMENT INPUT
==================================================*/

.display-placement-field input,
.display-placement-field select {

    width: 100%;

    min-height: 40px;

    box-sizing: border-box;

    padding: 8px 10px;

    border: 1px solid #d1d5db;

    border-radius: 8px;

    background: var(--white);

    color: #374151;

    font-family: inherit;

    font-size: 12px;

    line-height: 1.5;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background-color .2s ease;

}

/*==================================================
    PLACEMENT INPUT HOVER
==================================================*/

.display-placement-field input:hover:not(:disabled),
.display-placement-field select:hover:not(:disabled) {

    border-color: #9ca3af;

}

/*==================================================
    PLACEMENT INPUT FOCUS
==================================================*/

.display-placement-field input:focus,
.display-placement-field select:focus {

    outline: none;

    border-color: var(--primary);

    box-shadow:
        0 0 0 3px
        rgba(5, 42, 68, .10);

}

/*==================================================
    PLACEMENT DISABLED
==================================================*/

.display-placement-field input:disabled,
.display-placement-field select:disabled {

    cursor: not-allowed;

    opacity: .65;

    background: #f3f4f6;

}

/*==================================================
    PLACEMENT HELP
==================================================*/

.display-placement-help {

    display: block;

    margin: 0;

    font-size: 11px;

    line-height: 1.7;

    color: #6b7280;

}

/*==================================================
    VIP SINGLE POSITION
==================================================*/

.display-location-item[data-location="slider-vip"]
.display-location-placement {

    display: flex;

    flex-direction: column;

}

/*==================================================
    VIP POSITION FIELD WIDTH
==================================================*/

.display-location-item[data-location="slider-vip"]
.display-placement-field {

    width: min(260px, 100%);

}

/*==================================================
    PENDING / INCOMPLETE SELECTION
==================================================

    The JavaScript uses:

        .is-selected

    for a currently active Location.

    A pending selection is visually treated as
    selected while the manager is choosing placement.

    This class is supported defensively in case
    the connector marks a pending state explicitly.

==================================================*/

.display-location-item.is-pending {

    border-color: var(--primary);

    background: #f8fafc;

    box-shadow:
        0 4px 14px
        rgba(5, 42, 68, .08);

}

/*==================================================
    PENDING PLACEMENT VISUAL
==================================================*/

.display-location-item.is-pending
.display-location-placement {

    opacity: 1;

}

/*==================================================
    INVALID / INCOMPLETE PLACEMENT
==================================================

    Reserved for future validation integration.

==================================================*/

.display-location-item.is-invalid {

    border-color: #dc2626;

}

/*==================================================
    ACCESSIBILITY

    Respect reduced-motion preference.

==================================================*/

@media (prefers-reduced-motion: reduce) {

    .display-location-item,
    .display-location-item-title,
    .display-location-placement,
    .display-placement-field input,
    .display-placement-field select {

        transition: none;

    }

}

/*==================================================
    TABLET
==================================================*/

@media (max-width: 900px) {

    .display-location-list {

        grid-template-columns: 1fr;

    }

}

/*==================================================
    MOBILE
==================================================*/

@media (max-width: 576px) {

    .display-location-group {

        gap: 16px;

    }

    .display-location-group + .display-location-group {

        margin-top: 26px;

        padding-top: 26px;

    }

    .display-location-select {

        padding: 14px;

    }

    .display-location-placement {

        padding: 14px;

    }

    .display-placement-field-group {

        grid-template-columns: 1fr;

    }

    .display-location-item[data-location="slider-vip"]
    .display-placement-field {

        width: 100%;

    }

    .display-location-item-title {

        font-size: 13px;

    }

    .display-location-item-description {

        font-size: 11px;

    }

    .display-placement-label {

        font-size: 11px;

    }

    .display-placement-help {

        font-size: 10px;

    }

}
