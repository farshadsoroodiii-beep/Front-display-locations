         COMPONENT HEADER
    =========================================== -->

    <header class="cars-component-header">

        <div class="component-title">

            <h2>
                محل‌های نمایش خودرو
            </h2>

            <p>
                مشخص کنید این خودرو در کدام بخش‌های سایت
                نمایش داده شود و جایگاه آن را تعیین کنید.
            </p>

        </div>

    </header>

